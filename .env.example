# Copy to .env and fill in values. Do not commit .env.

# --- Server ---
PORT=3000
# Trust proxy (set to 1 or true behind reverse proxy for correct req.ip in rate limiting)
# TRUST_PROXY=0
# CORS: comma-separated origins allowed for cross-origin requests (e.g. landing site on another domain).
# When set, the app sends Access-Control-Allow-Credentials: true and uses SameSite=None for the session cookie in production so the browser can send cookies from those origins. Leave unset for same-origin only.
# CORS_ORIGIN=https://app.example.com,https://www.example.com

# --- Database ---
# Development uses SQLite at data/mico.sqlite. Production uses PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Magic-link email (Resend, production) ---
# Set these to send sign-in links by email. Leave unset in development (token is returned in API response).
RESEND_API_KEY=
APP_BASE_URL=https://your-clawkpit-instance.example.com
MAGIC_LINK_FROM_EMAIL=Clawkpit <login@yourdomain.com>
# Ops notification when a new account is created (first magic-link for a new email).
# Uses the first set value among ADMIN_EMAIL, OPS_EMAIL, MAINTAINER_EMAIL.
MAINTAINER_EMAIL=you@example.com

# --- Web push notifications (production) ---
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@yourdomain.com

# --- Frontend (optional) ---
# Public URL of this app (links in the UI). Defaults to window.location.origin at runtime.
# VITE_APP_URL=https://your-clawkpit-instance.example.com
# When agent skill docs (agent.md) are served from a different origin (e.g. landing at clawkpit.com, app at app.clawkpit.com), set this to the docs base URL for the connect-agent modal.
# VITE_AGENT_DOCS_URL=https://clawkpit.com
# Deprecated alias (still honored): VITE_OPENCLAW_DOCS_URL

# --- MCP server (in-process on same port as API) ---
# MCP_ENABLED=true
# MCP_RATE_LIMIT=120
# MCP_RATE_WINDOW_MS=60000
# Production host guard (optional): when APP_BASE_URL or MCP_ALLOWED_HOSTS is set, /mcp only accepts matching Host headers unless MCP_HOST_GUARD=false.
# MCP_ALLOWED_HOSTS=clawkpit.example.com,www.clawkpit.example.com
# MCP_HOST_GUARD=true
