{
  "name": "clawkpit",
  "version": "1.0.0",
  "description": "Clawkpit CLI for AI agents — token-efficient alternative to MCP",
  "type": "module",
  "bin": {
    "clawkpit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "clawkpit",
    "cli",
    "agent",
    "tasks",
    "kanban"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
